# Copie para .env e preencha. Nunca commite o .env.
ANTHROPIC_API_KEY=
# Modelo Claude usado nas gerações (confira o nome exato em docs.claude.com)
LLM_MODEL=claude-opus-5-5
# real = chama a API do Claude | mock = fixtures determinísticas, roda sem chave
LLM_MODE=mock
# Profundidade de raciocínio do modelo (low | medium | high | xhigh | max)
LLM_EFFORT=medium
DATABASE_URL=postgresql+psycopg://housia:housia@db:5432/housia
# hapi = lê o HAPI FHIR | local = monta os cenários em memória (dev/testes sem Docker)
FHIR_MODE=hapi
FHIR_BASE_URL=http://fhir:8080/fhir
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
LOG_PROMPTS=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Consulta com IA ---
# Transcrição no servidor (opcional): endpoint compatível com /v1/audio/transcriptions (Whisper on-premise etc.).
# Vazio = a tela usa o reconhecimento de fala do navegador (Chrome/Edge). Ver docs/decisions/0009.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Envia a nota aprovada ao prontuário como FHIR DocumentReference (true no compose de demonstração)
EHR_WRITEBACK=true
