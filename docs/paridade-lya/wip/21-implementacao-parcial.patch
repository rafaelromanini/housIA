+    )
+    module = tmp_path / "exemplo_tabagismo.py"
+    module.write_text(EXAMPLE_MODULE, encoding="utf-8")
+    app = apps.load_file(module)
+    yield app
+    apps.unregister("exemplo_tabagismo")
