diff --git a/apps/api/app/consult/fidelidade.py b/apps/api/app/consult/fidelidade.py
new file mode 100644
index 0000000..fe0dbf1
--- /dev/null
+++ b/apps/api/app/consult/fidelidade.py
@@ -0,0 +1,75 @@
+"""Fidelidade da tradução: números, unidades, doses e medicamentos têm de sobreviver à tradução.
+
+Checagem determinística (sem LLM) entre a fala original e a tradução. Divergência vira alerta "tradução divergente":
+trocar "500 mg" por "50 mg" ou perder um medicamento muda a conduta, então o profissional confere a fala original.
+"""
+
+import re
+from functools import lru_cache
+
+from app.consult.text import norm
+from app.reference import drugs
+
+UNIDADES = r"mg|mcg|ug|g|kg|ml|l|ui|u|meq|mmol|mmhg|bpm|%|graus|c|x"
+NUMERO = re.compile(rf"(?<![\w.,])(\d+(?:[.,]\d+)?)\s*({UNIDADES})?(?![a-z0-9])", re.IGNORECASE)
+
+
+# números por extenso (pt, es, en) viram dígito para a comparação; "um/uno/one" ficam de fora (também são artigo)
+_EXTENSO = {
+    "dois": "2", "duas": "2", "two": "2", "tres": "3", "three": "3", "quatro": "4", "cuatro": "4", "four": "4",
+    "cinco": "5", "five": "5", "seis": "6", "six": "6", "sete": "7", "siete": "7", "seven": "7", "oito": "8",
+    "ocho": "8", "eight": "8", "nove": "9", "nueve": "9", "nine": "9", "dez": "10", "diez": "10", "ten": "10",
+}  # fmt: skip
+_EXTENSO_RE = re.compile(r"(?<!\w)(" + "|".join(_EXTENSO) + r")(?!\w)")
+# "dos" é o 2 do espanhol, mas em português é "de os": só conta diante de unidade de tempo ou de dose
+_DOS = re.compile(r"(?<!\w)dos(?= (dias|horas|semanas|meses|anos|veces|pastillas|comprimidos|tabletas|gotas|dosis))")
+
+
+def _valor(txt: str) -> str:
+    v = txt.replace(",", ".")
+    if "." in v:
+        v = v.rstrip("0").rstrip(".")
+    return v.lstrip("0") or "0"
+
+
+def numeros(texto: str) -> set[tuple[str, str]]:
+    """Pares (valor, unidade) da fala; unidade vazia quando o número vem solto."""
+    t = _EXTENSO_RE.sub(lambda m: _EXTENSO[m.group(1)], _DOS.sub("2", norm(texto)))
+    return {(_valor(m.group(1)), (m.group(2) or "").lower()) for m in NUMERO.finditer(t)}
+
+
+@lru_cache
+def _radicais() -> tuple[tuple[str, str], ...]:
+    """(radical, princípio ativo): 'losartan' acha 'losartana' (pt) e 'losartán' (es); 'metformin' acha o inglês."""
+    out = []
+    for ing, d in drugs().items():
+        for name in {norm(d.name.partition("+")[0]), norm(ing.partition("+")[0])}:
+            stem = name.rstrip("aeo")
+            if len(stem) >= 6:
+                out.append((stem, ing))
+    return tuple(out)
+
+
+def medicamentos(texto: str) -> set[str]:
+    t = norm(texto)
+    return {ing for stem, ing in _radicais() if re.search(rf"(?<!\w){re.escape(stem)}", t)}
+
+
+def divergencias(original: str, traducao: str) -> list[str]:
+    """Descrições das diferenças entre a fala e a tradução (lista vazia: a tradução é fiel nesses pontos)."""
+    out: list[str] = []
+    a, b = numeros(original), numeros(traducao)
+    va, vb = {v for v, _ in a}, {v for v, _ in b}
+    if va - vb:
+        out.append("números do original ausentes na tradução: " + ", ".join(sorted(va - vb)))
+    if vb - va:
+        out.append("números na tradução que não estão no original: " + ", ".join(sorted(vb - va)))
+    # mesmo valor com unidade diferente ("500 mg" → "500 mcg"); a unidade omitida na tradução não conta
+    ua = {v: u for v, u in a if u}
+    for v, u in b:
+        if u and v in ua and ua[v] != u:
+            out.append(f"unidade trocada em {v}: {ua[v]} → {u}")
+    da, db = medicamentos(original), medicamentos(traducao)
+    if da != db:
+        out.append("medicamentos diferentes entre original e tradução: " + ", ".join(sorted(da ^ db)))
+    return out
diff --git a/apps/api/app/consult/idiomas.py b/apps/api/app/consult/idiomas.py
new file mode 100644
index 0000000..be2b252
--- /dev/null
+++ b/apps/api/app/consult/idiomas.py
@@ -0,0 +1,101 @@
+"""Idiomas da consulta (data/reference/languages.csv): BCP-47 com rótulo e os códigos da Web Speech e do Whisper.
+
+O idioma deixa de ser uma lista fixa no código: entra qualquer código do CSV (≥ 95 idiomas). Também resolve o idioma
+preferido do paciente (Patient.communication) e prepara a fala estrangeira para as regras quando ainda não há tradução.
+"""
+
+import re
+from dataclasses import dataclass
+from functools import lru_cache
+
+from app.reference import _read_csv
+from app.timeline.record import normalize
+
+PADRAO = "pt-BR"
+MARCA_MOCK = " — tradução com LLM real"  # aviso que o modo mock põe numa fala sem tradução pré-gravada
+
+
+def placeholder(traducao: str | None) -> bool:
+    return bool(traducao) and MARCA_MOCK in traducao
+
+
+@dataclass(frozen=True)
+class Idioma:
+    codigo: str
+    rotulo: str
+    web_speech: str  # reconhecimento e voz do navegador ("" quando o navegador não cobre)
+    whisper: str  # código do Whisper para a transcrição no servidor ("" quando não cobre)
+
+
+@lru_cache
+def todos() -> dict[str, Idioma]:
+    return {
+        r["codigo"]: Idioma(r["codigo"], r["rotulo"], r.get("web_speech", ""), r.get("whisper", ""))
+        for r in _read_csv("languages.csv")
+    }
+
+
+def resolver(codigo: str | None) -> str | None:
+    """Código canônico do CSV para `pt`, `PT-br`, `es-MX`, `zh_CN`…; None se o idioma não existe."""
+    if not codigo:
+        return None
+    raw = codigo.strip().replace("_", "-")
+    known = todos()
+    by_lower = {k.lower(): k for k in known}
+    if raw.lower() in by_lower:
+        return by_lower[raw.lower()]
+    base = raw.split("-")[0].lower()
+    if base == "pt":
+        return PADRAO
+    return by_lower.get(base)
+
+
+def validar(codigo: str) -> str:
+    """Validador do schema: devolve o código canônico ou recusa o idioma desconhecido."""
+    found = resolver(codigo)
+    if found is None:
+        raise ValueError(f"Idioma desconhecido: {codigo!r} (use um código de data/reference/languages.csv)")
+    return found
+
+
+def rotulo(codigo: str) -> str:
+    found = todos().get(resolver(codigo) or codigo)
+    return found.rotulo if found else codigo
+
+
+def opcoes() -> list[dict]:
+    return [
+        {"value": i.codigo, "label": i.rotulo, "web_speech": i.web_speech or i.codigo, "whisper": i.whisper}
+        for i in todos().values()
+    ]
+
+
+def do_paciente(patient: dict) -> tuple[str | None, str]:
+    """Idioma preferido em Patient.communication (preferred=true, senão o primeiro) e o rótulo da fonte."""
+    comms = patient.get("communication") or []
+    ordered = sorted(comms, key=lambda c: not c.get("preferred"))
+    for comm in ordered:
+        for coding in (comm.get("language") or {}).get("coding", []):
+            found = resolver(coding.get("code"))
+            if found:
+                return found, "Patient.communication"
+    return None, ""
+
+
+# ---------- fala estrangeira ainda sem tradução ----------
+# As regras são em português. Enquanto a tradução não chega, espanhol e inglês são lidos pelos sinônimos dos CSVs;
+# a negação deles é levada ao "não" que o motor entende ("no me duele" → "nao me duele"). Em português "no" é
+# "em o" ("dor no peito"), por isso a troca só vale para falas que NÃO estão em português.
+_NEGA = {
+    "es": re.compile(r"(?<!\w)(no|nunca|jamas|sin|ningun[oa]?|ni)(?!\w)"),
+    "en": re.compile(r"(?<!\w)(no|not|never|without|none|nor|neither)(?!\w)|n't(?!\w)"),
+}
+
+
+def texto_para_regras(texto: str, idioma: str) -> str:
+    """Texto que o motor lê numa fala estrangeira sem tradução; em pt-BR (ou outro idioma) devolve o texto como está."""
+    base = (resolver(idioma) or idioma).split("-")[0]
+    pattern = _NEGA.get(base)
+    if pattern is None:
+        return texto
+    return pattern.sub(" nao ", normalize(texto))
