+    ("0", ("nunca", "nenhuma vez", "nao tenho", "nao sinto", "de jeito nenhum")),
+)
+_IPSS_TRIGGERS: dict[str, tuple[str, ...]] = {
+    "esvaziamento": (
+        "nao esvazia",
