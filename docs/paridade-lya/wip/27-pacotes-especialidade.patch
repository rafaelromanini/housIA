+# ---------- estimativas pela fala ----------
+_FREQ_WORDS = (
+    ("5", ("quase sempre", "sempre", "toda vez", "todas as vezes", "quase toda vez")),
+    ("4", ("mais da metade", "na maioria das vezes", "maioria das vezes", "quase toda hora")),
