# Copie para .env.prod (nunca commite). Todos os valores abaixo são obrigatórios em produção.
HOUSIA_DOMAIN=housia.hospital.example
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
# real = IA externa (exige ANTHROPIC_API_KEY, LLM_MODEL e, para a tela Ambiente, LLM_REGION)
LLM_MODE=real
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_REGION=
# Provedor substituível (#54): anthropic (padrão) ou openai_compat (vLLM/Ollama; exige LLM_BASE_URL, LLM_MODEL e, se externo, LLM_API_KEY)
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
# true: servidor na rede da instituição (pula a pseudonimização de saída; a auditoria continua)
LLM_ON_PREMISE=false
# regiões aceitas, separadas por vírgula (vazio: sem política)
LLM_ALLOWED_REGIONS=
# true só para aceitar explicitamente rodar apenas com regras locais (LLM_MODE=mock)
ALLOW_MOCK=false
EHR_WRITEBACK=false
# Certificado do hospital (opcional): "/certs/hospital.crt /certs/hospital.key"
CADDY_TLS=
